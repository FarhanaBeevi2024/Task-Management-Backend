# Supabase (same project as the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Same value as VITE_SUPABASE_ANON_KEY — required for password reset emails (resetPasswordForEmail).
SUPABASE_ANON_KEY=

PORT=3001
LOG_LEVEL=info

# Base URL of the Task Flow web app (no trailing slash). Used in invitation links and password recovery redirects.
# Local dev (Vite default in this repo): http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Set to true only when you want recovery links logged to the console instead of sending email (local/staging).
# Production must leave this unset or false.
# PASSWORD_RESET_NO_EMAIL=false
