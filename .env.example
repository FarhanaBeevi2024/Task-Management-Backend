# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Same anon key as frontend (VITE_SUPABASE_ANON_KEY) — required for server-triggered
# password reset emails (`/api/public/auth/recovery-action`).
SUPABASE_ANON_KEY=

# Frontend origin for auth redirects
FRONTEND_URL=http://localhost:3000

# Logging: error | warn | info | debug
# `debug`: password recovery skips sending email (avoids Supabase rate limits) and logs the
# recovery link server-side only. Use `info` or `error` in production for real emails.
LOG_LEVEL=info

PORT=3001
